{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Read(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(sudo *)"
    ]
  }
}
